{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://negaccelsimulator.local/schema/negaccel-authoring.schema.json",
  "title": "NegAccelSimulator Python authoring specification",
  "description": "User-facing Python-side case authoring model. The workflow tool materializes this organized input into the canonical runtime case JSON consumed by the C++ simulator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "geometry",
    "boundaryConditions",
    "particleSource",
    "gasInteractions",
    "run"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "caseTag"
      ],
      "properties": {
        "schemaVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "caseTag": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "description": {
          "type": "string"
        },
        "author": {
          "type": "string"
        }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template",
        "meshSizeMeters"
      ],
      "properties": {
        "template": {
          "type": "string",
          "enum": [
            "SPIDER",
            "MITICA",
            "MTF"
          ]
        },
        "meshSizeMeters": {
          "$ref": "#/$defs/positiveNumber"
        },
        "exportGeometryVtk": {
          "type": "boolean"
        },
        "domain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "xSizeMeters",
            "ySizeMeters",
            "zSizeMeters"
          ],
          "properties": {
            "xSizeMeters": {
              "$ref": "#/$defs/positiveNumber"
            },
            "ySizeMeters": {
              "$ref": "#/$defs/positiveNumber"
            },
            "zSizeMeters": {
              "$ref": "#/$defs/positiveNumber"
            }
          }
        },
        "gaps": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "extractionGapMeters": {
              "$ref": "#/$defs/positiveNumber"
            },
            "accelerationGapMeters": {
              "$ref": "#/$defs/positiveNumber"
            }
          }
        }
      }
    },
    "boundaryConditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gridVoltagesVolts"
      ],
      "properties": {
        "gridVoltagesVolts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "extractionGrid",
            "acceleratorStages"
          ],
          "properties": {
            "extractionGrid": {
              "type": "number"
            },
            "acceleratorStages": {
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "items": {
                "type": "number"
              }
            }
          }
        },
        "periodicBoundaries": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "xMinMeters": {
              "type": "number"
            },
            "xMaxMeters": {
              "type": "number"
            },
            "yMinMeters": {
              "type": "number"
            },
            "yMaxMeters": {
              "type": "number"
            }
          }
        }
      }
    },
    "particleSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "massU",
        "currentDensityAm2",
        "axialEnergyEV"
      ],
      "properties": {
        "species": {
          "type": "string",
          "enum": [
            "H-",
            "D-",
            "custom"
          ],
          "default": "H-"
        },
        "chargeState": {
          "type": "number",
          "default": -1
        },
        "massU": {
          "$ref": "#/$defs/positiveNumber"
        },
        "currentDensityAm2": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "perpendicularTemperatureEV": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "parallelTemperatureEV": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "axialEnergyEV": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "plasmaPotentialVolts": {
          "type": "number"
        },
        "electronsModelWeight": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "sourceModel": {
          "type": "string",
          "enum": [
            "uniform",
            "gaussian",
            "measured",
            "custom"
          ],
          "default": "uniform"
        }
      }
    },
    "magneticField": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "case": {
          "type": "integer",
          "minimum": 0
        },
        "scale": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "sourceMode": {
          "type": "string",
          "enum": [
            "auto-by-accelerator",
            "directory",
            "file"
          ]
        },
        "directory": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "filePattern": {
          "type": "string"
        }
      }
    },
    "gasInteractions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "densityProfile"
      ],
      "properties": {
        "densityProfile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "species",
            "path"
          ],
          "properties": {
            "name": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "species": {
              "type": "string",
              "enum": [
                "H2",
                "H0",
                "H+",
                "e-",
                "custom"
              ]
            },
            "path": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "format": {
              "type": "string",
              "default": "z-density-columns"
            },
            "pressureScale": {
              "$ref": "#/$defs/nonNegativeNumber"
            },
            "useFor": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "stripping",
                  "secondaryEmission",
                  "diagnostics"
                ]
              }
            }
          }
        },
        "stripping": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "generateSecondaries": {
              "type": "boolean"
            },
            "minimumZMeters": {
              "$ref": "#/$defs/nonNegativeNumber"
            }
          }
        }
      }
    },
    "surfaceInteractions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "model": {
          "type": "string",
          "enum": [
            "EAMCC"
          ]
        },
        "minimumImpactZMeters": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "maximumSecondaryElectrons": {
          "type": "integer",
          "minimum": 0
        },
        "secondaryElectronEnergyEV": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "debug": {
          "type": "boolean"
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "particleCount",
        "iterations"
      ],
      "properties": {
        "particleCount": {
          "type": "integer",
          "minimum": 1
        },
        "iterations": {
          "type": "integer",
          "minimum": 1
        },
        "domainDecomposition": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "splitDomain": {
              "type": "boolean"
            },
            "domainIndex": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "solver": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "bicgstab",
                "multigrid"
              ]
            },
            "shieldModel": {
              "type": "string",
              "enum": [
                "nsimp",
                "shield"
              ]
            }
          }
        },
        "spaceCharge": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "alphaCoeff": {
              "$ref": "#/$defs/nonNegativeNumber"
            },
            "pgFilterScale": {
              "$ref": "#/$defs/nonNegativeNumber"
            },
            "cesmadcmScale": {
              "$ref": "#/$defs/nonNegativeNumber"
            }
          }
        },
        "convergence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "currentDensityTolerance": {
              "$ref": "#/$defs/nonNegativeNumber"
            }
          }
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "$ref": "#/$defs/outputChannel"
        },
        "plots": {
          "$ref": "#/$defs/outputChannel"
        },
        "data": {
          "$ref": "#/$defs/outputChannel"
        },
        "vtk": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "directory": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "exportGeometry": {
              "type": "boolean"
            },
            "exportSimulationState": {
              "type": "boolean"
            },
            "exportTracedParticles": {
              "type": "boolean"
            }
          }
        },
        "logging": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "consoleLevel": {
              "$ref": "#/$defs/logLevel"
            },
            "fileLevel": {
              "$ref": "#/$defs/logLevel"
            },
            "captureStdout": {
              "type": "boolean"
            },
            "writeDebugArtifacts": {
              "type": "boolean"
            },
            "structuredLogFile": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "positiveNumber": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "nonNegativeNumber": {
      "type": "number",
      "minimum": 0
    },
    "logLevel": {
      "type": "string",
      "enum": [
        "trace",
        "debug",
        "info",
        "warning",
        "error",
        "critical"
      ]
    },
    "outputChannel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "directory": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    }
  }
}