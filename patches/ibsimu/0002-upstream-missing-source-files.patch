+class BGICallback : public TrajectoryHandlerCallback 
+{   //This is the first implementation of background gas interaction for the H- H0 H+ system, on basis of cross sections as function of energy. The MC approach is naive, just as a first step.
+    //Because the cross sections are just implemented as the computationally intensive fit functions from the Tabata_2000 article, this is slow. This will be improved by fitting e.g. polynomials.
+    //Or use interpolation? 
+    //Think about a proper way to implement the E/amu axis!! 
+    Geometry &_geom;
+    MTRandom  _randUniform;
+    MeshScalarField _bgneutr; 
+    double _sigmaHmH0, _sigmaHmHp, _sigmaH0Hm, _sigmaH0Hp, _sigmaHpH0, _sigmaHmal, _sigmaH0al, _brancHmH0, _brancHmHp, _brancH0Hm, _brancH0Hp;
+
+public:
+
+    BGICallback( Geometry &geom ) 
+        : _geom(geom), _randUniform(1), _bgneutr(geom) {
+
+        for( size_t i = 0; i < _bgneutr.size(0); i++ ) { //CURRENTLY ONE DENSITY IS MANUALLY SPECIFIED HERE 
+            for( size_t j = 0; j < _bgneutr.size(1); j++ ) {
+                for ( size_t k = 0; k < _bgneutr.size(2); k++ ) {                            
+                    _bgneutr( i, j, k ) =  1.0; //Density is in units of 1E+20 m-3             
+                }
+            }
+        }
+    }
+
+    virtual ~BGICallback() {}
+
+    virtual void operator()( ParticleBase *particle, ParticlePBase *x1, ParticlePBase *x2, ParticlePBase *xend, class ParticleDataBase *pdb )
+    {
+        Particle3D *partic = (Particle3D *) ( particle );
+        ParticleP3D *p3dx1 = (ParticleP3D *)( x1 );
+        ParticleP3D *p3dx2 = (ParticleP3D *)( x2 );
+        ParticleP3D *p3dxe = (ParticleP3D *)( xend );
+        ParticleDataBase3D *pdb3d = (ParticleDataBase3D *)( pdb );
+
+        Vec3D temploc1 = p3dx1->location();    
+        Vec3D temploc2 = p3dx2->location();  
+        Vec3D templodx = temploc2 - temploc1;     //Distance between the two points.
+        Vec3D temploxm = temploc1 + 0.5*templodx; //Middle point between the two locations.
+        Vec3D tempvexm = 0.5*(p3dx2->velocity() + p3dx1->velocity()); //Average velocity of the particle.
+        double tempEkeV = (0.5*MASS_U*tempvexm.ssqr()/CHARGE_E)*1.0E-3; //Energy at middle point in keV/amu, needed to calculate the rates. (.5mv^2/(m/u))*(1/e)*1.0E-3
+        double mcrand[0], psrand[0], mcphys, nsigma, distan, disnor; 
+        _randUniform.get( mcrand );
+
+        // std::cout << "Here comes some diagnostic information" << std::endl;
+        // std::cout << tempEkeV << std::endl;
+        // std::cout << sigma_Hm_to_H0(tempEkeV) << std::endl;
+        // std::cout << sigma_Hm_to_Hp(tempEkeV) << std::endl;
+        // std::cout << sigma_H0_to_Hm(tempEkeV) << std::endl;
+        // std::cout << sigma_H0_to_Hp(tempEkeV) << std::endl;
+        // std::cout << sigma_Hp_to_H0(tempEkeV) << std::endl;
+        // exit( 007 );
+     
+        if ( particle->q() == -CHARGE_E) //Charge exchange of negatively charged particles
+        {
+            double sigmHmH0 = sigma_Hm_to_H0(tempEkeV);
+            double sigmHmHp = sigma_Hm_to_Hp(tempEkeV);
+            double sigmHmal = sigmHmH0 + sigmHmHp;
+
+            nsigma = _bgneutr(temploxm) * sigmHmal;      //No need for sums over paths, the TrajectoryHandlerCallback is called every grid cell.
+            mcphys = exp( - templodx.norm2() * nsigma ); //Equation (2) from Stäbler_1994
+            if( mcrand[0] > mcphys ) //Because mcrand needs to be bigger, and mcphys is always positive, in principle it cannot be zero (which would give a pole error in the log function). 
+            {
+                distan = (-1.0/nsigma)*log(mcrand[0]);  //This is equation (3) from Stäbler_1994
+                disnor = distan/templodx.norm2();       //This should be a number between 0 and 1 indicating where the particle is between the two.
+                for ( size_t a = 0; a < p3dxe->size(); a ++ )
+                {
+                    p3dxe[0][a] = p3dx1[0][a] + disnor*(p3dx2[0][a] - p3dx1[0][a]); //The particle is created with linearly interpolated properties.
+                }
+                partic->set_status( PARTICLE_COLL ); //Also the end point needs to be updated
+
+                _randUniform.get( psrand ); //Determine which of the two processes is the one which is going to be the winner.
+                if( psrand[0] < (sigmHmH0/sigmHmal) )
+                {
+                    pdb3d->add_particle(particle->IQ(),  0.0, particle->m()/MASS_U, *p3dxe); //IQ, q, m, ParticleP3D   
+                }
+                else
+                {
+                    pdb3d->add_particle(particle->IQ(), +1.0, particle->m()/MASS_U, *p3dxe); //IQ, q, m, ParticleP3D   
+                }
+            }
+        }
+        else if ( particle->q() == 0.0) //Charge exchange of neutral particles
+        {   //There are two processes possible, H0 -> H- and H0 -> H+. This is the naive implementation, first I determine the chance at an event, then I share the events based on the sigma ratio.   
+            double sigmH0Hm = sigma_H0_to_Hm(tempEkeV);
+            double sigmH0Hp = sigma_H0_to_Hp(tempEkeV);
+            double sigmH0al = sigmH0Hm + sigmH0Hp;
+
+            nsigma = _bgneutr(temploxm) * sigmH0al;    //No need for sums over paths, the TrajectoryHandlerCallback is called every grid cell.
+            mcphys = exp( - templodx.norm2() * nsigma ); //Equation (2) from Stäbler_1994
+            if( mcrand[0] > mcphys ) //Because mcrand needs to be bigger, and mcphys is always positive, in principle it cannot be zero (which would give a pole error in the log function). 
+            {
+                distan = (-1.0/nsigma)*log(mcrand[0]);  //This is equation (3) from Stäbler_1994
+                disnor = distan/templodx.norm2();       //This should be a number between 0 and 1 indicating where the particle is between the two.
+                for ( size_t a = 0; a < p3dxe->size(); a ++ )
+                {
+                    p3dxe[0][a] = p3dx1[0][a] + disnor*(p3dx2[0][a] - p3dx1[0][a]); //The particle is created with linearly interpolated properties.
+                }
+                partic->set_status( PARTICLE_COLL ); //Also the end point needs to be updated
+
+                _randUniform.get( psrand ); //Determine which of the two processes is the one which is going to be the winner.
+                if( psrand[0] < (sigmH0Hm/sigmH0al) )
+                {
+                    pdb3d->add_particle(particle->IQ(), -1.0, particle->m()/MASS_U, *p3dxe); //IQ, q, m, ParticleP3D   
+                }
+                else
+                {
+                    pdb3d->add_particle(particle->IQ(), +1.0, particle->m()/MASS_U, *p3dxe); //IQ, q, m, ParticleP3D   
+                }
+            }
+        }
+        else if ( particle->q() == +CHARGE_E) //Charge exchange of positively charged particles
+        {
+            nsigma = _bgneutr(temploxm) * sigma_Hp_to_H0(tempEkeV);      //No need for sums over paths, the TrajectoryHandlerCallback is called every grid cell.
+            mcphys = exp( - templodx.norm2() * nsigma );  //Equation (2) from Stäbler_1994
+            if( mcrand[0] > mcphys ) //Because mcrand needs to be bigger, and mcphys is always positive, in principle it cannot be zero (which would give a pole error in the log function). 
+            {
+                distan = (-1.0/nsigma)*log(mcrand[0]);  //This is equation (3) from Stäbler_1994
+                disnor = distan/templodx.norm2();       //This should be a number between 0 and 1 indicating where the particle is between the two.
+                for ( size_t a = 0; a < p3dxe->size(); a ++ )
+                {
+                    p3dxe[0][a] = p3dx1[0][a] + disnor*(p3dx2[0][a] - p3dx1[0][a]); //The particle is created with linearly interpolated properties.
+                }
+                partic->set_status( PARTICLE_COLL ); //Also the end point needs to be updated
+                pdb3d->add_particle(particle->IQ(), 0.0, particle->m()/MASS_U, *p3dxe); //IQ, q, m, ParticleP3D   
+            }
+        }
+    }
+
+};
