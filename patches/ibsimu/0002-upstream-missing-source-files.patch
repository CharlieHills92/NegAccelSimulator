+void print_particle_statistics( ParticleStatistics stat ) //This function is shamelessly copied from the particledatabaseimp.hpp file. 
+{
+    std::cout << "Particles flown \t= " << stat.bound_collisions() << std::endl;
+    std::cout << "time limited \t\t= " << stat.end_time() <<  std::endl;
+    std::cout << "step count limited \t= " << stat.end_step() << std::endl;
+    std::cout << "bad definitions \t= " << stat.end_baddef() << std::endl;
+    for( size_t a = 1; a <= stat.number_of_boundaries(); a++ ) 
+    {
+        std::cout << "  beam to boundary " << a << " = " << stat.bound_current(a)
+                << " A (" << stat.bound_collisions(a) << " particles)" << std::endl;
+    }
+    std::cout << "total steps \t\t= " << stat.sum_steps() << std::endl;
+    std::cout << "avg steps per part(?) \t= " <<  stat.sum_steps()/(double)stat.bound_collisions() << std::endl;
+}
+
+void write_particle_statistics( ParticleStatistics stat, std::ofstream &myfile ) //This function writes particle statistics to an output file instead of the output stream
+{
+    myfile << "particles flown : \t" << stat.bound_collisions() << "\n";
+    myfile << "time lim: \t" << stat.end_time() <<  "\n";
+    myfile << "step lim: \t" << stat.end_step() << "\n";
+    myfile << "bad defs: \t" << stat.end_baddef() << "\n";
+    for( size_t a = 1; a <= stat.number_of_boundaries(); a++ ) 
+    {
+        myfile << "to boundary " << a << " [A]: \t" << stat.bound_current(a) << "\n";
+    }
+    for( size_t a = 1; a <= stat.number_of_boundaries(); a++ ) 
+    {
+        myfile << "to boundary " << a << " [ ]: \t" << stat.bound_collisions(a) << "\n";
+    }
+    myfile << "total steps: \t" << stat.sum_steps() << "\n";
+    myfile << "avg steps p: \t" <<  stat.sum_steps()/(double)stat.bound_collisions() << "\n";
+}
