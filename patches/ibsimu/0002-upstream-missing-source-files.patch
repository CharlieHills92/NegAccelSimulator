+const double ER = 13.605693009E-3; //This is the Rydberg energy in keV. NOTE: all the functions need keV as energy variable! Taken from the 2014 CODATA recommended values data set.
+
+double f1(double x, double c1, double c2) //Note the absence of the c0 prefactor. As a result, the cross sections are all in units of 1.0E-20 m2!
+{   //This is from the 'analytic expressions' section in the Tabata_2000 article
+    return c1*pow(x/ER, c2);
+}
+double f2(double x, double c1, double c2, double c3, double c4)
+{   //This is from the 'analytic expressions' section in the Tabata_2000 article
+    return f1(x, c1, c2)/( 1.0 + pow(x/c3, (c2+c4)) );
+}
+double f3(double x, double c1, double c2, double c3, double c4, double c5, double c6)
+{   //This is from the 'analytic expressions' section in the Tabata_2000 article
+    return f1(x, c1, c2)/( 1.0 + pow(x/c3, (c2+c4)) + pow(x/c5, (c2+c6)) );
+}
+double f4(double x, double c1, double c2, double c3, double c4, double c5, double c6, double c7, double c8)
+{   //This is from the 'analytic expressions' section in the Tabata_2000 article
+    return f1(x, c1, c2)*( 1.0 + pow(x/c3, (c4-c2)) )/( 1.0 + pow(x/c5, (c4+c6)) + pow(x/c7, (c4+c8)) );
+}
+
+double e01(double E1, double a1, double a2, double a3, double a4)
+{   //This is from the 'analytic expressions' section in the Tabata_2000 article
+    return f2(E1, a1, a2, a3, a4);
+}
+double e02(double E1, double a1, double a2, double a3, double a4, double a5, double a6)
+{   //This is from the 'analytic expressions' section in the Tabata_2000 article
+    return ( f2(E1, a1, a2, a3, a4) + a5*f2(E1/a6, a1, a2, a3, a4) ); //Note: because only the first four elements of at are used by the two f2 calls there is no need to pass a slice of the array.
+}
+double e06(double E1, double a1, double a2, double a3, double a4, double a5, double a6)
+{   //This is from the 'analytic expressions' section in the Tabata_2000 article
+    return f3(E1, a1, a2, a3, a4, a5, a6);
+}
+double e08(double E1, double a1, double a2, double a3, double a4, double a5, double a6, double a7, double a8, double a9)
+{   //This is from the 'analytic expressions' section in the Tabata_2000 article
+    return ( f2(E1, a1, a2, a3, a4) + f3(E1, a5, a2, a6, a7, a8, a9) );
+}
+double e11(double E1, double a1, double a2, double a3, double a4, double a5, double a6, double a7, double a8, double a9, double a10)
+{   //This is from the 'analytic expressions' section in the Tabata_2000 article
+    return ( f3(E1, a1, a2, a3, a4, a5, a6) + f2(E1, a7, a8, a9, a10) );
+}
+double e13(double E1, double a1, double a2, double a3, double a4, double a5, double a6, double a7, double a8, double a9, double a10, double a11, double a12)
+{   //This is from the 'analytic expressions' section in the Tabata_2000 article
+    return ( f3(E1, a1, a2, a3, a4, a5, a6) + f3(E1, a7, a8, a9, a10, a11, a12) );
+}
+
+double sigma_Hm_to_H0(double E)
+{   //This is reaction 47 from Tabata_2000
+    if( E < 2.37E-3 ) //Emin and Emax are given in Table I.
+      return 0.0;
+    if( E > 5.00E+1 )
+      return 0.0;
+    double Eth = 2.25E-3; //Eth in keV
+    double ci[10] = {4.19E-2, 1.89, 1.78E-1, -2.3E-1, 1.04, 8.7E-1, 1.65E+1, 1.088, 5.33E-3, 1.66E-1};
+    double E1 = E - Eth;
+    return e11(E1, ci[0], ci[1], ci[2], ci[3], ci[4], ci[5], ci[6], ci[7], ci[8], ci[9]);
+}
+double sigma_Hm_to_Hp(double E)
+{   //This is reaction 49 from Tabata_2000 (an Eth of 0.0 keV)
+    if( E < 1.00 ) //Emin and Emax are given in Table I.
+      return 0.0;
+    if( E > 3.00E+2 )
+      return 0.0;
+    double ci[6] = {1.75E-8, 3.88, 9.06E-1, -2.74E-1, 3.19, 1.19};
+    return e06(E, ci[0], ci[1], ci[2], ci[3], ci[4], ci[5]);
+}
+double sigma_H0_to_Hm(double E)
+{   //This is reaction 29 from Tabata_2000
+    if( E < 2.37E-2 ) //Emin and Emax are given in Table I.
+      return 0.0;
+    if( E > 9.11E+1 )
+      return 0.0;
+    double Eth = 2.1E-2; //Eth in keV
+    double ci[12] = {9.73E-3, 2.38, 1.39E-2, -5.51E-1, 7.7E-2, 2.12, 1.97E-6, 2.051, 5.5, 6.62E-1, 2.02E+1, 3.62}; //In C++11 these two lines could be done much more logical and 'pythonic'.
+    double E1 = E - Eth;
+    return e13(E1, ci[0], ci[1], ci[2], ci[3], ci[4], ci[5], ci[6], ci[7], ci[8], ci[9], ci[10], ci[11]);
+}
+double sigma_H0_to_Hp(double E)
+{   //This is reaction 31 from Tabata_2000
+    if( E < 5.62E-2 ) //Emin and Emax are given in Table I.
+      return 0.0;
+    if( E > 1.12E+2 )
+      return 0.0;
+    double Eth = 2.0E-2; //Eth in keV
+    double ci[6] = {2.53E-4, 1.728, 2.164, 7.74E-1, 1.639, 1.43E+1};
+    double E1 = E - Eth;
+    return e02(E1, ci[0], ci[1], ci[2], ci[3], ci[4], ci[5]);
+}
+double sigma_Hp_to_H0(double E)
+{   //This is reaction  6 from Tabata_2000
+    if( E < 3.16E-3 ) //Emin and Emax are given in Table I.
+      return 0.0;
+    if( E > 1.00E+2 )
+      return 0.0;
+    double Eth = 2.5E-3; //Eth in keV
+    double ci[9] = {2.12E+2, 1.721, 6.7E-4, 3.239E-1, 4.34E-3, 1.296, 1.42E-1, 9.34, 2.997};
+    double E1 = E - Eth;
+    return e08(E1, ci[0], ci[1], ci[2], ci[3], ci[4], ci[5], ci[6], ci[7], ci[8]);
+}
