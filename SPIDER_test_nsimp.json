    "maximumSecondaryElectrons": 26,
    "secondaryElectronEnergyEV": 10.0,
    "debug": false
  },
  "run": {
    "iterations": 20,
    "solver": {
      "type": "bicgstab",
      "bicgstab": {
        "eps": 0.0001,
        "maxIterations": 10000,
        "newtonEps": 0.0001,
        "newtonMaxIterations": 10,
        "globallyConvergentNewton": true
      },
      "multigrid": {
        "levels": 2,
        "mgTolerance": 0.0001,
        "maxCycles": 100,
        "gamma": 1,
        "preSmooth": 5,
        "postSmooth": 5,
        "coarseRelaxation": 1.7,
        "coarseMaxIterations": 10000,
        "localPlasmaMaxIterations": 1
      }
    },
    "spaceCharge": {
      "alphaCoeff": 1.5
    },
    "convergence": {
      "currentDensityTolerance": 1.0
    },
    "domainDecomposition": {
      "splitDomain": false
    }
  },
