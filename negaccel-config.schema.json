{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://negaccelsimulator.local/schema/negaccel-config.schema.json",
  "title": "NegAccelSimulator resolved case configuration",
  "description": "Canonical single-case runtime JSON for NegAccelSimulator. Python-side tooling can author or expand these files, while the C++ simulator consumes one fully resolved case at a time.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "accelerator",
    "geometry",
    "particleSources",
    "simulation",
    "boundaryConditions",
    "externalMagneticField",
    "gasDensity",
    "physics",
    "outputs"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "caseTag"
      ],
      "properties": {
        "schemaVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Version of the JSON configuration contract, not the simulator version.",
          "examples": [
            "1.0.0"
          ]
        },
        "caseTag": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "Stable case identifier used by Python orchestration and output naming."
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "description": {
          "type": "string"
        },
        "author": {
          "type": "string"
        }
      }
    },
    "accelerator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "BUG",
            "SPIDER",
            "MITICA",
            "MTF",
            "ELISE",
            "NIO1",
            "CUSTOM"
          ],
          "description": "Human-readable accelerator selector that should eventually replace ACCELERATOR_IDX."
        },
        "legacyIndex": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional compatibility field matching the current ACCELERATOR_IDX values."
        },
        "useBuiltInDefaults": {
          "type": "boolean",
          "default": true,
          "description": "Whether accelerator-specific defaults are applied when optional fields are omitted."
        }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "mesh",
        "domain"
      ],
      "properties": {
        "source": {
          "description": "Geometry definition source. The current code mostly builds geometry from accelerator-specific generators, but the schema also allows a custom file path for future GUI-driven geometries.",
          "oneOf": [
            {
              "$ref": "#/$defs/builtinGeometrySource"
            },
            {
              "$ref": "#/$defs/customGeometrySource"
            }
          ]
        },
        "mesh": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sizeMeters"
          ],
          "properties": {
            "sizeMeters": {
              "$ref": "#/$defs/positiveNumber",
              "description": "Primary mesh size. This replaces MESH_SIZE."
            },
            "refinementScale": {
              "$ref": "#/$defs/positiveNumber"
            },
            "exportGeometryVtk": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "domain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "xSizeMeters",
            "ySizeMeters",
            "zSizeMeters"
          ],
          "properties": {
            "xSizeMeters": {
              "$ref": "#/$defs/positiveNumber"
            },
            "ySizeMeters": {
              "$ref": "#/$defs/positiveNumber"
            },
            "zSizeMeters": {
              "$ref": "#/$defs/positiveNumber"
            }
          }
        },
        "gaps": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "extractionGapMeters": {
              "$ref": "#/$defs/positiveNumber",
              "description": "Optional replacement for EXT_GAP."
            },
            "accelerationGapMeters": {
              "$ref": "#/$defs/positiveNumber",
              "description": "Optional replacement for ACC_GAP."
            }
          }
        },
        "solids": {
          "type": "array",
          "description": "Optional explicit solid inventory for GUI-oriented editing and labeling.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "kind"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "grid",
                  "aperture",
                  "wall",
                  "plasma",
                  "diagnosticPlane",
                  "custom"
                ]
              },
              "material": {
                "type": "string"
              },
              "notes": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "particleSources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "negativeIonBeam"
      ],
      "properties": {
        "negativeIonBeam": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "massU",
            "currentDensityAm2",
            "axialEnergyEV"
          ],
          "properties": {
            "species": {
              "type": "string",
              "enum": [
                "H-",
                "D-",
                "custom"
              ],
              "default": "H-"
            },
            "chargeState": {
              "type": "number",
              "default": -1
            },
            "massU": {
              "$ref": "#/$defs/positiveNumber",
              "description": "Particle mass in atomic mass units. This replaces M_IONS."
            },
            "currentDensityAm2": {
              "$ref": "#/$defs/nonNegativeNumber",
              "description": "Injected beam current density. This replaces J or J_ION."
            },
            "perpendicularTemperatureEV": {
              "$ref": "#/$defs/nonNegativeNumber",
              "description": "Replaces T_PERP or TPERP."
            },
            "parallelTemperatureEV": {
              "$ref": "#/$defs/nonNegativeNumber",
              "description": "Replaces TPAR when present."
            },
            "axialEnergyEV": {
              "$ref": "#/$defs/nonNegativeNumber",
              "description": "Replaces E0_Z."
            },
            "plasmaPotentialVolts": {
              "type": "number",
              "description": "Plasma potential or meniscus voltage, replacing U_PLASMA when the source model uses it."
            },
            "electronsModelWeight": {
              "$ref": "#/$defs/nonNegativeNumber",
              "description": "Optional replacement for the current ELECTRONS parameter."
            },
            "sourceModel": {
              "type": "string",
              "enum": [
                "uniform",
                "gaussian",
                "measured",
                "custom"
              ],
              "default": "uniform"
            }
          }
        },
        "additionalEmitters": {
          "type": "array",
          "description": "Optional explicit emitter list for future GUI workflows or test drivers.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "species",
              "emissionModel"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "species": {
                "type": "string",
                "enum": [
                  "H-",
                  "H0",
                  "H+",
                  "e-",
                  "custom"
                ]
              },
              "emissionModel": {
                "type": "string",
                "enum": [
                  "surface",
                  "volume",
                  "loaded-pdb",
                  "custom"
                ]
              },
              "currentDensityAm2": {
                "$ref": "#/$defs/nonNegativeNumber"
              },
              "file": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "particleCount",
        "iterations",
        "solver",
        "spaceCharge",
        "convergence"
      ],
      "properties": {
        "particleCount": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of simulation particles. This replaces N_PARTICLES."
        },
        "iterations": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of electrostatic or tracing iterations. This replaces ITERATIONS."
        },
        "domainDecomposition": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "splitDomain": {
              "type": "boolean",
              "description": "Replacement for SPLIT_DOMAIN."
            },
            "domainIndex": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "solver": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "bicgstab",
                "multigrid"
              ],
              "description": "Replacement for MGSOLVER."
            },
            "shieldModel": {
              "type": "string",
              "enum": [
                "nsimp",
                "shield"
              ],
              "description": "Replacement for SHIELD_MODEL."
            },
            "positiveIonTemperatureEV": {
              "$ref": "#/$defs/nonNegativeNumber",
              "description": "Replacement for T_POSITIVE."
            },
            "plasmaPotentialVolts": {
              "type": "number"
            }
          }
        },
        "spaceCharge": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "alphaCoeff"
          ],
          "properties": {
            "alphaCoeff": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Replacement for ALPHA_COEFF."
            },
            "pgFilterScale": {
              "$ref": "#/$defs/nonNegativeNumber",
              "description": "Replacement for PGFILTER_SCALE."
            },
            "cesmadcmScale": {
              "$ref": "#/$defs/nonNegativeNumber",
              "description": "Replacement for CESMADCM_SCALE."
            }
          }
        },
        "convergence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "currentDensityTolerance"
          ],
          "properties": {
            "currentDensityTolerance": {
              "$ref": "#/$defs/nonNegativeNumber",
              "description": "Replacement for JTOLERANCE."
            }
          }
        }
      }
    },
    "boundaryConditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "electrodes"
      ],
      "properties": {
        "electrodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/electrodeBoundary"
          }
        },
        "periodicBoundaries": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "xMinMeters": {
              "type": "number"
            },
            "xMaxMeters": {
              "type": "number"
            },
            "yMinMeters": {
              "type": "number"
            },
            "yMaxMeters": {
              "type": "number"
            }
          }
        },
        "forcedPotentialRegions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "zMaxMeters"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "zMaxMeters": {
                "type": "number"
              },
              "xAbsLimitMeters": {
                "$ref": "#/$defs/nonNegativeNumber"
              },
              "yAbsLimitMeters": {
                "$ref": "#/$defs/nonNegativeNumber"
              }
            }
          }
        }
      }
    },
    "externalMagneticField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "sourceMode"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Replacement for B_ISON."
        },
        "case": {
          "type": "integer",
          "minimum": 0,
          "description": "Replacement for EXTFIELD_CASE when a predefined field family is used."
        },
        "scale": {
          "$ref": "#/$defs/nonNegativeNumber",
          "default": 1.0,
          "description": "Replacement for EXTFIELD_SCALE."
        },
        "sourceMode": {
          "type": "string",
          "enum": [
            "none",
            "auto-by-accelerator",
            "directory",
            "file"
          ]
        },
        "directory": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "filePattern": {
          "type": "string"
        }
      }
    },
    "gasDensity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultProfile",
        "profiles"
      ],
      "properties": {
        "defaultProfile": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "Profile name selected by default for stripping, secondaries, and diagnostics. When stripping is enabled, the current C++ runtime expects the selected profile to resolve to a file-backed source."
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "species",
              "source",
              "useFor"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "species": {
                "type": "string",
                "enum": [
                  "H2",
                  "H0",
                  "H+",
                  "e-",
                  "custom"
                ]
              },
              "source": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/fileDensitySource"
                  },
                  {
                    "$ref": "#/$defs/inlineDensitySource"
                  }
                ]
              },
              "pressureScale": {
                "$ref": "#/$defs/nonNegativeNumber",
                "description": "Optional multiplier used when translating tabulated density profiles into an effective operating pressure."
              },
              "useFor": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "stripping",
                    "secondaryEmission",
                    "diagnostics"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "physics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stripping",
        "surfaceCollisions"
      ],
      "properties": {
        "stripping": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "disabled",
                "primaryOnly",
                "withSecondaries"
              ],
              "description": "Replacement for STRIPPING or INCLUDE_STRIPPING."
            },
            "minimumZMeters": {
              "$ref": "#/$defs/nonNegativeNumber",
              "description": "Lower z threshold for secondary generation. This matches the current THCallback_secondaries guard."
            },
            "densityProfile": {
              "type": "string",
              "description": "Name of the gas-density profile used by stripping callbacks. This must match a gasDensity.profiles[*].name entry with source.mode='file'."
            },
            "debugWindowStart": {
              "type": "integer",
              "minimum": 0
            },
            "debugWindowEnd": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "surfaceCollisions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Replacement for INCLUDE_SURFACE_COLLISIONS."
            },
            "model": {
              "type": "string",
              "enum": [
                "EAMCC"
              ]
            },
            "maximumSecondaryElectrons": {
              "type": "integer",
              "minimum": 0,
              "description": "Future replacement for MAX_SECONDARY_ELECTRONS."
            },
            "secondaryElectronEnergyEV": {
              "$ref": "#/$defs/nonNegativeNumber",
              "description": "Future replacement for SECONDARY_ELECTRON_ENERGY."
            },
            "debug": {
              "type": "boolean",
              "description": "Enable verbose EAMCC surface-collision callback logging even when global debug mode is off."
            },
            "minimumImpactZMeters": {
              "$ref": "#/$defs/nonNegativeNumber",
              "description": "Lower z threshold for surface-collision secondary generation. This replaces the previous hardcoded 7 mm cutoff."
            }
          }
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rootDirectory",
        "summary",
        "plots",
        "data",
        "vtk",
        "logging"
      ],
      "properties": {
        "rootDirectory": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "Intended output root for the resolved case. Python tooling should keep this aligned with the folder containing the generated case JSON."
        },
        "summary": {
          "$ref": "#/$defs/outputChannel"
        },
        "plots": {
          "$ref": "#/$defs/outputChannel"
        },
        "data": {
          "$ref": "#/$defs/outputChannel"
        },
        "vtk": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "directory"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "directory": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "exportGeometry": {
              "type": "boolean"
            },
            "exportSimulationState": {
              "type": "boolean"
            },
            "exportTracedParticles": {
              "type": "boolean"
            }
          }
        },
        "logging": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consoleLevel",
            "fileLevel"
          ],
          "properties": {
            "consoleLevel": {
              "$ref": "#/$defs/logLevel"
            },
            "fileLevel": {
              "$ref": "#/$defs/logLevel"
            },
            "captureStdout": {
              "type": "boolean"
            },
            "writeDebugArtifacts": {
              "type": "boolean"
            },
            "structuredLogFile": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "positiveNumber": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "nonNegativeNumber": {
      "type": "number",
      "minimum": 0
    },
    "logLevel": {
      "type": "string",
      "enum": [
        "trace",
        "debug",
        "info",
        "warning",
        "error",
        "critical"
      ]
    },
    "builtinGeometrySource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "template"
      ],
      "properties": {
        "mode": {
          "const": "builtin-generator"
        },
        "template": {
          "type": "string",
          "enum": [
            "BUG",
            "SPIDER",
            "MITICA",
            "MTF",
            "ELISE",
            "NIO1",
            "CUSTOM"
          ]
        }
      }
    },
    "customGeometrySource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "path"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "custom-file",
            "generated-data"
          ]
        },
        "path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "format": {
          "type": "string",
          "enum": [
            "header",
            "json",
            "vtk",
            "dat"
          ]
        }
      }
    },
    "electrodeBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "role",
        "voltageVolts"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "role": {
          "type": "string",
          "enum": [
            "extraction_grid",
            "accelerator_grid",
            "ground_grid",
            "repeller",
            "wall",
            "plasma",
            "custom"
          ]
        },
        "stage": {
          "type": "integer",
          "minimum": 0
        },
        "voltageVolts": {
          "type": "number"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "material": {
          "type": "string"
        }
      }
    },
    "fileDensitySource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "path",
        "format"
      ],
      "properties": {
        "mode": {
          "const": "file"
        },
        "path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "format": {
          "type": "string",
          "enum": [
            "z-density-columns"
          ]
        }
      }
    },
    "inlineDensitySource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "points"
      ],
      "properties": {
        "mode": {
          "const": "inline-table"
        },
        "interpolation": {
          "type": "string",
          "enum": [
            "linear",
            "step"
          ],
          "default": "linear"
        },
        "points": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "zMeters",
              "densityPerM3"
            ],
            "properties": {
              "zMeters": {
                "type": "number"
              },
              "densityPerM3": {
                "$ref": "#/$defs/nonNegativeNumber"
              }
            }
          }
        }
      }
    },
    "outputChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "directory"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "directory": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "filePrefix": {
          "type": "string"
        }
      }
    }
  }
}
