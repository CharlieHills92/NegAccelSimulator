{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://negaccelsimulator.local/schema/negaccel-config.schema.json",
  "title": "NegAccelSimulator resolved case configuration",
  "description": "Canonical single-case runtime JSON for NegAccelSimulator. The Python authoring workflow materializes this explicit runtime contract, and the C++ simulator executes one resolved case at a time.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "geometry",
    "particleSources",
    "simulation",
    "boundaryConditions",
    "externalMagneticField",
    "gasDensity",
    "physics",
    "outputs"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "caseTag"
      ],
      "properties": {
        "schemaVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "caseTag": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "description": {
          "type": "string"
        },
        "author": {
          "type": "string"
        }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "mesh",
        "domain",
        "solids"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/generatedGeometrySource"
        },
        "mesh": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sizeMeters",
            "exportGeometryVtk"
          ],
          "properties": {
            "sizeMeters": {
              "$ref": "#/$defs/positiveNumber"
            },
            "exportGeometryVtk": {
              "type": "boolean"
            }
          }
        },
        "domain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "xSizeMeters",
            "ySizeMeters",
            "zSizeMeters"
          ],
          "properties": {
            "xSizeMeters": {
              "$ref": "#/$defs/positiveNumber"
            },
            "ySizeMeters": {
              "$ref": "#/$defs/positiveNumber"
            },
            "zSizeMeters": {
              "$ref": "#/$defs/positiveNumber"
            },
            "zStartMeters": {
              "type": "number"
            }
          }
        },
        "gaps": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "extractionGapMeters": {
              "$ref": "#/$defs/positiveNumber"
            }
          }
        },
        "solids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/geometrySolid"
          }
        }
      }
    },
    "particleSources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "negativeIonBeam"
      ],
      "properties": {
        "negativeIonBeam": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "massU",
            "currentDensityAm2",
            "axialEnergyEV"
          ],
          "properties": {
            "species": {
              "type": "string",
              "enum": [
                "H-",
                "D-",
                "custom"
              ]
            },
            "chargeState": {
              "type": "number"
            },
            "massU": {
              "$ref": "#/$defs/positiveNumber"
            },
            "currentDensityAm2": {
              "$ref": "#/$defs/nonNegativeNumber"
            },
            "perpendicularTemperatureEV": {
              "$ref": "#/$defs/nonNegativeNumber"
            },
            "parallelTemperatureEV": {
              "$ref": "#/$defs/nonNegativeNumber"
            },
            "axialEnergyEV": {
              "$ref": "#/$defs/nonNegativeNumber"
            },
            "plasmaPotentialVolts": {
              "type": "number"
            },
            "electronsModelWeight": {
              "$ref": "#/$defs/nonNegativeNumber"
            },
            "sourceModel": {
              "type": "string",
              "enum": [
                "uniform",
                "gaussian",
                "measured",
                "custom"
              ]
            }
          }
        }
      }
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "particleCount",
        "iterations",
        "domainDecomposition",
        "solver",
        "spaceCharge",
        "convergence"
      ],
      "properties": {
        "particleCount": {
          "type": "integer",
          "minimum": 1
        },
        "iterations": {
          "type": "integer",
          "minimum": 1
        },
        "domainDecomposition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "splitDomain"
          ],
          "properties": {
            "splitDomain": {
              "type": "boolean"
            },
            "domainIndex": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "solver": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "shieldModel"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "bicgstab",
                "multigrid"
              ]
            },
            "shieldModel": {
              "type": "string",
              "enum": [
                "nsimp",
                "shield"
              ]
            }
          }
        },
        "spaceCharge": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "alphaCoeff",
            "pgFilterScale",
            "cesmadcmScale"
          ],
          "properties": {
            "alphaCoeff": {
              "$ref": "#/$defs/nonNegativeNumber"
            },
            "pgFilterScale": {
              "$ref": "#/$defs/nonNegativeNumber"
            },
            "cesmadcmScale": {
              "$ref": "#/$defs/nonNegativeNumber"
            }
          }
        },
        "convergence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "currentDensityTolerance"
          ],
          "properties": {
            "currentDensityTolerance": {
              "$ref": "#/$defs/nonNegativeNumber"
            }
          }
        }
      }
    },
    "boundaryConditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundaries"
      ],
      "properties": {
        "boundaries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/boundaryDefinition"
          }
        },
        "periodicBoundaries": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "xMinMeters": {
              "type": "number"
            },
            "xMaxMeters": {
              "type": "number"
            },
            "yMinMeters": {
              "type": "number"
            },
            "yMaxMeters": {
              "type": "number"
            }
          }
        }
      }
    },
    "externalMagneticField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "sourceMode",
        "scale"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "sourceMode": {
          "type": "string",
          "enum": [
            "none",
            "directory",
            "file"
          ]
        },
        "case": {
          "type": "integer",
          "minimum": 0
        },
        "scale": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "directory": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "file": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "properties": {
              "sourceMode": {
                "enum": [
                  "directory",
                  "file"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "sourceMode": {
                "const": "directory"
              }
            }
          },
          "then": {
            "required": [
              "directory"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "sourceMode": {
                "const": "file"
              }
            }
          },
          "then": {
            "required": [
              "file"
            ]
          }
        }
      ]
    },
    "gasDensity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultProfile",
        "profiles"
      ],
      "properties": {
        "defaultProfile": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/gasDensityProfile"
          }
        }
      }
    },
    "physics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stripping",
        "surfaceCollisions"
      ],
      "properties": {
        "stripping": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "disabled",
                "primaryOnly",
                "withSecondaries"
              ]
            },
            "minimumZMeters": {
              "$ref": "#/$defs/nonNegativeNumber"
            },
            "densityProfile": {
              "$ref": "#/$defs/nonEmptyString"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "enum": [
                      "primaryOnly",
                      "withSecondaries"
                    ]
                  }
                }
              },
              "then": {
                "required": [
                  "densityProfile"
                ]
              }
            }
          ]
        },
        "surfaceCollisions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "model": {
              "type": "string",
              "enum": [
                "EAMCC"
              ]
            },
            "minimumImpactZMeters": {
              "$ref": "#/$defs/nonNegativeNumber"
            },
            "maximumSecondaryElectrons": {
              "type": "integer",
              "minimum": 0
            },
            "secondaryElectronEnergyEV": {
              "$ref": "#/$defs/nonNegativeNumber"
            },
            "debug": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rootDirectory",
        "summary",
        "plots",
        "data",
        "vtk",
        "logging"
      ],
      "properties": {
        "rootDirectory": {
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/outputChannel"
        },
        "plots": {
          "$ref": "#/$defs/outputChannel"
        },
        "data": {
          "$ref": "#/$defs/outputChannel"
        },
        "vtk": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "directory",
            "exportGeometry",
            "exportSimulationState",
            "exportTracedParticles"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "directory": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "exportGeometry": {
              "type": "boolean"
            },
            "exportSimulationState": {
              "type": "boolean"
            },
            "exportTracedParticles": {
              "type": "boolean"
            }
          }
        },
        "logging": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consoleLevel",
            "fileLevel",
            "captureStdout",
            "writeDebugArtifacts",
            "structuredLogFile"
          ],
          "properties": {
            "consoleLevel": {
              "$ref": "#/$defs/logLevel"
            },
            "fileLevel": {
              "$ref": "#/$defs/logLevel"
            },
            "captureStdout": {
              "type": "boolean"
            },
            "writeDebugArtifacts": {
              "type": "boolean"
            },
            "structuredLogFile": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "positiveNumber": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "nonNegativeNumber": {
      "type": "number",
      "minimum": 0
    },
    "logLevel": {
      "type": "string",
      "enum": [
        "critical",
        "error",
        "warning",
        "info",
        "debug",
        "trace"
      ]
    },
    "generatedGeometrySource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "path",
        "format"
      ],
      "properties": {
        "mode": {
          "const": "generated-data"
        },
        "path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "format": {
          "type": "string",
          "enum": [
            "json"
          ]
        }
      }
    },
    "geometrySolid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "zProfileMeters",
        "rProfileMeters"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "kind": {
          "type": "string",
          "enum": [
            "solid",
            "diagnosticPlane"
          ]
        },
        "role": {
          "type": "string"
        },
        "stage": {
          "type": "integer"
        },
        "boundaryId": {
          "type": "integer",
          "minimum": 1
        },
        "voltageVolts": {
          "type": "number"
        },
        "zProfileMeters": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "number"
          }
        },
        "rProfileMeters": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "roundingRadiiMeters": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "number"
          }
        },
        "aperturePattern": {
          "$ref": "#/$defs/aperturePattern"
        }
      }
    },
    "aperturePattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layout"
      ],
      "properties": {
        "layout": {
          "type": "string",
          "enum": [
            "single",
            "rectangular-grid",
            "staggered-grid"
          ]
        },
        "countX": {
          "type": "integer",
          "minimum": 1
        },
        "countY": {
          "type": "integer",
          "minimum": 1
        },
        "pitchXMeters": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "pitchYMeters": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "marginMeters": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "xOffsetMeters": {
          "type": "number"
        },
        "yOffsetMeters": {
          "type": "number"
        },
        "rowShiftXMeters": {
          "type": "number"
        },
        "outsidePatternIsSolid": {
          "type": "boolean"
        }
      }
    },
    "boundaryDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundaryId",
        "conditionType",
        "value"
      ],
      "properties": {
        "boundaryId": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string"
        },
        "conditionType": {
          "type": "string",
          "enum": [
            "dirichlet",
            "neumann"
          ]
        },
        "value": {
          "type": "number"
        }
      }
    },
    "gasDensityProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "species",
        "source",
        "useFor"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "species": {
          "type": "string",
          "enum": [
            "H2",
            "H0",
            "H+",
            "e-",
            "custom"
          ]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "path"
          ],
          "properties": {
            "mode": {
              "const": "file"
            },
            "path": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "pressureScale": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "useFor": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "stripping",
              "secondaryEmission",
              "diagnostics"
            ]
          }
        }
      }
    },
    "outputChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "directory"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "directory": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    }
  }
}
