{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://negaccelsimulator.local/schema/negaccel-config.schema.json",
  "title": "NegAccelSimulator resolved case configuration",
  "description": "Canonical single-case runtime JSON for NegAccelSimulator. The Python authoring workflow materializes this explicit runtime contract, and the C++ simulator executes one resolved case at a time.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "geometry",
    "particleSources",
    "simulation",
    "boundaryConditions",
    "externalMagneticField",
    "gasDensity",
    "physics",
    "diagnostics",
    "outputs"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "caseTag"
      ],
      "properties": {
        "schemaVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "caseTag": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "description": {
          "type": "string"
        },
        "author": {
          "type": "string"
        }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "mesh",
        "domain",
        "solids"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/generatedGeometrySource"
        },
        "mesh": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sizeMeters",
            "exportGeometryVtk"
          ],
          "properties": {
            "sizeMeters": {
              "$ref": "#/$defs/positiveNumber"
            },
            "exportGeometryVtk": {
              "type": "boolean"
            }
          }
        },
        "domain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "xSizeMeters",
            "ySizeMeters",
            "zSizeMeters"
          ],
          "properties": {
            "xSizeMeters": {
              "$ref": "#/$defs/positiveNumber"
            },
            "ySizeMeters": {
              "$ref": "#/$defs/positiveNumber"
            },
            "zSizeMeters": {
              "$ref": "#/$defs/positiveNumber"
            },
            "zStartMeters": {
              "type": "number"
            }
          }
        },
        "gaps": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "extractionGapMeters": {
              "$ref": "#/$defs/positiveNumber"
            }
          }
        },
        "solids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/geometrySolid"
          }
        }
      }
    },
    "particleTypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "chargeState",
          "massU"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "name": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "kind": {
            "type": "string",
            "enum": [
              "H-",
              "H0",
              "H+",
              "H2+",
              "H20",
              "H3+",
              "D-",
              "D0",
              "D+",
              "D2+",
              "D20",
              "D3+",
              "e-"
            ]
          },
          "chargeState": {
            "type": "number"
          },
          "massU": {
            "$ref": "#/$defs/positiveNumber"
          },
          "sourceable": {
            "type": "boolean"
          }
        }
      }
    },
    "particleSources": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "negativeIonBeam": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "massU",
                "currentDensityAm2",
                "axialEnergyEV"
              ],
              "properties": {
                "species": {
                  "type": "string",
                  "enum": [
                    "H-",
                    "D-",
                    "custom"
                  ]
                },
                "chargeState": {
                  "type": "number"
                },
                "massU": {
                  "$ref": "#/$defs/positiveNumber"
                },
                "currentDensityAm2": {
                  "$ref": "#/$defs/nonNegativeNumber"
                },
                "perpendicularTemperatureEV": {
                  "$ref": "#/$defs/nonNegativeNumber"
                },
                "parallelTemperatureEV": {
                  "$ref": "#/$defs/nonNegativeNumber"
                },
                "axialEnergyEV": {
                  "$ref": "#/$defs/nonNegativeNumber"
                },
                "plasmaPotentialVolts": {
                  "type": "number"
                },
                "electronsModelWeight": {
                  "$ref": "#/$defs/nonNegativeNumber"
                },
                "sourceModel": {
                  "type": "string",
                  "enum": [
                    "uniform",
                    "gaussian",
                    "measured",
                    "custom"
                  ]
                }
              }
            }
          }
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "particleTypeId",
              "kind",
              "chargeState",
              "massU",
              "particleCount",
              "currentDensityAm2",
              "axialEnergyEV",
              "sourceModel",
              "uniform"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "name": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "particleTypeId": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "H-",
                  "H0",
                  "H+",
                  "H2+",
                  "H20",
                  "D-",
                  "D0",
                  "D+",
                  "D2+",
                  "D20",
                  "e-"
                ]
              },
              "chargeState": {
                "type": "number"
              },
              "massU": {
                "$ref": "#/$defs/positiveNumber"
              },
              "particleCount": {
                "type": "integer",
                "minimum": 1
              },
              "currentDensityAm2": {
                "$ref": "#/$defs/nonNegativeNumber"
              },
              "perpendicularTemperatureEV": {
                "$ref": "#/$defs/nonNegativeNumber"
              },
              "parallelTemperatureEV": {
                "$ref": "#/$defs/nonNegativeNumber"
              },
              "axialEnergyEV": {
                "$ref": "#/$defs/nonNegativeNumber"
              },
              "sourceModel": {
                "type": "string",
                "enum": [
                  "uniform"
                ]
              },
              "uniform": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "centerMeters",
                  "mainDirection",
                  "inPlaneReferenceDirection",
                  "widthMeters",
                  "heightMeters"
                ],
                "properties": {
                  "centerMeters": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number"
                    }
                  },
                  "mainDirection": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number"
                    }
                  },
                  "inPlaneReferenceDirection": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number"
                    }
                  },
                  "widthMeters": {
                    "$ref": "#/$defs/positiveNumber"
                  },
                  "heightMeters": {
                    "$ref": "#/$defs/positiveNumber"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "particleCount",
        "iterations",
        "domainDecomposition",
        "solver",
        "spaceCharge",
        "convergence"
      ],
      "properties": {
        "particleCount": {
          "type": "integer",
          "minimum": 1
        },
        "iterations": {
          "type": "integer",
          "minimum": 1
        },
        "domainDecomposition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "splitDomain"
          ],
          "properties": {
            "splitDomain": {
              "type": "boolean"
            },
            "domainIndex": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "solver": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "anyOf": [
            {
              "required": [
                "shieldModel"
              ]
            },
            {
              "required": [
                "plasmaModel"
              ]
            }
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "bicgstab",
                "multigrid"
              ]
            },
            "shieldModel": {
              "type": "string",
              "enum": [
                "nsimp",
                "shield"
              ]
            },
            "plasmaModel": {
              "type": "string",
              "enum": [
                "nsimp",
                "shield"
              ]
            },
            "initialPlasmaMaxZMeters": {
              "type": "number"
            },
            "positiveIonTemperatureEV": {
              "$ref": "#/$defs/nonNegativeNumber"
            },
            "plasmaPotentialVolts": {
              "type": "number"
            },
            "tanhWidthEV": {
              "$ref": "#/$defs/positiveNumber"
            },
            "meniscusVoltageVolts": {
              "type": "number"
            },
            "bicgstab": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "eps": {
                  "$ref": "#/$defs/positiveNumber"
                },
                "maxIterations": {
                  "type": "integer",
                  "minimum": 1
                },
                "newtonEps": {
                  "$ref": "#/$defs/positiveNumber"
                },
                "newtonMaxIterations": {
                  "type": "integer",
                  "minimum": 1
                },
                "globallyConvergentNewton": {
                  "type": "boolean"
                }
              }
            },
            "multigrid": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "levels": {
                  "type": "integer",
                  "minimum": 1
                },
                "mgTolerance": {
                  "$ref": "#/$defs/positiveNumber"
                },
                "maxCycles": {
                  "type": "integer",
                  "minimum": 1
                },
                "gamma": {
                  "type": "integer",
                  "minimum": 1
                },
                "preSmooth": {
                  "type": "integer",
                  "minimum": 1
                },
                "postSmooth": {
                  "type": "integer",
                  "minimum": 1
                },
                "coarseRelaxation": {
                  "$ref": "#/$defs/positiveNumber"
                },
                "coarseMaxIterations": {
                  "type": "integer",
                  "minimum": 1
                },
                "localPlasmaMaxIterations": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        },
        "spaceCharge": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "alphaCoeff"
          ],
          "properties": {
            "alphaCoeff": {
              "$ref": "#/$defs/nonNegativeNumber"
            }
          }
        },
        "convergence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "currentDensityTolerance"
          ],
          "properties": {
            "currentDensityTolerance": {
              "$ref": "#/$defs/nonNegativeNumber"
            }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serverCommand": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "Optional GUI launch wrapper command used to run the simulator inside a remote or cluster shell. The C++ simulator ignores this block."
        }
      }
    },
    "boundaryConditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundaries"
      ],
      "properties": {
        "boundaries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/boundaryDefinition"
          }
        },
        "periodicBoundaries": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "xMinMeters": {
              "type": "number"
            },
            "xMaxMeters": {
              "type": "number"
            },
            "yMinMeters": {
              "type": "number"
            },
            "yMaxMeters": {
              "type": "number"
            }
          }
        }
      }
    },
    "externalMagneticField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "fields"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "directory": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "sourceType",
              "scale"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "sourceType": {
                "type": "string",
                "enum": [
                  "constant",
                  "file"
                ]
              },
              "scale": {
                "$ref": "#/$defs/nonNegativeNumber"
              },
              "constantValue": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "bx",
                  "by",
                  "bz"
                ],
                "properties": {
                  "bx": {
                    "type": "number"
                  },
                  "by": {
                    "type": "number"
                  },
                  "bz": {
                    "type": "number"
                  }
                }
              },
              "filePath": {
                "$ref": "#/$defs/nonEmptyString"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "sourceType": {
                      "const": "constant"
                    }
                  }
                },
                "then": {
                  "required": [
                    "constantValue"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "sourceType": {
                      "const": "file"
                    }
                  }
                },
                "then": {
                  "required": [
                    "filePath"
                  ]
                }
              }
            ]
          }
        }
      }
    },
    "gasDensity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultProfile",
        "profiles"
      ],
      "properties": {
        "defaultProfile": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/gasDensityProfile"
          }
        }
      }
    },
    "physics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stripping",
        "surfaceCollisions"
      ],
      "properties": {
        "stripping": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "disabled",
                "primaryOnly",
                "withSecondaries"
              ]
            },
            "minimumZMeters": {
              "$ref": "#/$defs/nonNegativeNumber"
            },
            "densityProfile": {
              "$ref": "#/$defs/nonEmptyString"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "enum": [
                      "primaryOnly",
                      "withSecondaries"
                    ]
                  }
                }
              },
              "then": {
                "required": [
                  "densityProfile"
                ]
              }
            }
          ]
        },
        "reactions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/crossSectionProcessRuntime"
          }
        },
        "surfaceCollisions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "model": {
              "type": "string",
              "enum": [
                "EAMCC"
              ]
            },
            "minimumImpactZMeters": {
              "$ref": "#/$defs/nonNegativeNumber"
            },
            "maximumSecondaryElectrons": {
              "type": "integer",
              "minimum": 0
            },
            "secondaryElectronEnergyEV": {
              "$ref": "#/$defs/nonNegativeNumber"
            },
            "debug": {
              "type": "boolean"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "stripping": {
                "properties": {
                  "mode": {
                    "enum": [
                      "primaryOnly",
                      "withSecondaries"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "reactions"
            ]
          }
        }
      ]
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rootDirectory",
        "summary",
        "plots",
        "data",
        "vtk",
        "iteration",
        "logging"
      ],
      "properties": {
        "rootDirectory": {
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/outputChannel"
        },
        "plots": {
          "$ref": "#/$defs/outputChannel"
        },
        "data": {
          "$ref": "#/$defs/outputChannel"
        },
        "vtk": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "directory",
            "exportGeometry",
            "exportSimulationState",
            "exportTracedParticles"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "directory": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "exportGeometry": {
              "type": "boolean"
            },
            "exportSimulationState": {
              "type": "boolean"
            },
            "exportTracedParticles": {
              "type": "boolean"
            }
          }
        },
        "iteration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "everyNIterations",
            "exportPlaneDiagnostics",
            "exportSimulationState",
            "exportTracedParticles",
            "planeZPositionsMeters"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "everyNIterations": {
              "type": "integer",
              "minimum": 1
            },
            "exportPlaneDiagnostics": {
              "type": "boolean"
            },
            "exportSimulationState": {
              "type": "boolean"
            },
            "exportTracedParticles": {
              "type": "boolean"
            },
            "planeZPositionsMeters": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          }
        },
        "logging": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consoleLevel",
            "fileLevel",
            "captureStdout",
            "writeDebugArtifacts",
            "structuredLogFile"
          ],
          "properties": {
            "consoleLevel": {
              "$ref": "#/$defs/logLevel"
            },
            "fileLevel": {
              "$ref": "#/$defs/logLevel"
            },
            "captureStdout": {
              "type": "boolean"
            },
            "writeDebugArtifacts": {
              "type": "boolean"
            },
            "structuredLogFile": {
              "type": "string"
            }
          }
        }
      }
    },
    "diagnostics": {
      "$ref": "#/$defs/diagnosticsConfig"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "positiveNumber": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "nonNegativeNumber": {
      "type": "number",
      "minimum": 0
    },
    "logLevel": {
      "type": "string",
      "enum": [
        "critical",
        "error",
        "warning",
        "info",
        "debug",
        "trace"
      ]
    },
    "generatedGeometrySource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "path",
        "format"
      ],
      "properties": {
        "mode": {
          "const": "generated-data"
        },
        "path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "format": {
          "type": "string",
          "enum": [
            "json"
          ]
        }
      }
    },
    "geometrySolid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "zProfileMeters",
        "rProfileMeters"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "kind": {
          "type": "string",
          "enum": [
            "solid",
            "diagnosticPlane"
          ]
        },
        "role": {
          "type": "string"
        },
        "stage": {
          "type": "integer"
        },
        "boundaryId": {
          "type": "integer",
          "minimum": 1
        },
        "voltageVolts": {
          "type": "number"
        },
        "zProfileMeters": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "number"
          }
        },
        "rProfileMeters": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "roundingRadiiMeters": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "number"
          }
        },
        "aperturePattern": {
          "$ref": "#/$defs/aperturePattern"
        }
      }
    },
    "aperturePattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layout"
      ],
      "properties": {
        "layout": {
          "type": "string",
          "enum": [
            "single",
            "rectangular-grid",
            "staggered-grid"
          ]
        },
        "countX": {
          "type": "integer",
          "minimum": 1
        },
        "countY": {
          "type": "integer",
          "minimum": 1
        },
        "pitchXMeters": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "pitchYMeters": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "marginMeters": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "xOffsetMeters": {
          "type": "number"
        },
        "yOffsetMeters": {
          "type": "number"
        },
        "rowShiftXMeters": {
          "type": "number"
        },
        "outsidePatternIsSolid": {
          "type": "boolean"
        }
      }
    },
    "boundaryDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundaryId",
        "conditionType",
        "value"
      ],
      "properties": {
        "boundaryId": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string"
        },
        "conditionType": {
          "type": "string",
          "enum": [
            "dirichlet",
            "neumann"
          ]
        },
        "value": {
          "type": "number"
        }
      }
    },
    "gasDensityProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "species",
        "source"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "species": {
          "type": "string",
          "enum": [
            "H2",
            "D2",
            "H0",
            "H+",
            "D0",
            "D+",
            "e-",
            "custom"
          ]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "path"
          ],
          "properties": {
            "mode": {
              "const": "file"
            },
            "path": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "format": {
              "type": "string"
            }
          }
        },
        "pressureScale": {
          "$ref": "#/$defs/nonNegativeNumber"
        }
      }
    },
    "particleKind": {
      "type": "string",
      "enum": [
        "H-",
        "H0",
        "H+",
        "H2+",
        "H20",
        "H3+",
        "D-",
        "D0",
        "D+",
        "D2+",
        "D20",
        "D3+",
        "e-"
      ]
    },
    "crossSectionProcessProductRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "particleKind",
        "speedClass"
      ],
      "properties": {
        "particleKind": {
          "$ref": "#/$defs/particleKind"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "speedClass": {
          "type": "string",
          "enum": [
            "fast",
            "slow"
          ]
        },
        "chargeState": {
          "type": "number"
        },
        "massU": {
          "$ref": "#/$defs/positiveNumber"
        }
      }
    },
    "crossSectionProcessRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourcePath",
        "fitDegree",
        "coefficients"
      ],
      "anyOf": [
        {
          "required": [
            "reactionId"
          ]
        },
        {
          "required": [
            "processId",
            "projectileKind",
            "projectileFate"
          ]
        }
      ],
      "properties": {
        "reactionId": {
          "type": "string",
          "enum": [
            "negative_ion_single_stripping",
            "negative_ion_double_stripping",
            "background_gas_ionization",
            "neutral_projectile_ionization",
            "positive_ion_charge_exchange"
          ]
        },
        "processId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "projectileKind": {
          "$ref": "#/$defs/particleKind"
        },
        "projectileFate": {
          "type": "string",
          "enum": [
            "consume",
            "survive"
          ]
        },
        "products": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/crossSectionProcessProductRuntime"
          }
        },
        "sourcePath": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "fitDegree": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "coefficients": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          }
        },
        "scaleEnergyByIonMass": {
          "type": "boolean"
        },
        "minimumEnergyEV": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "maximumEnergyEV": {
          "$ref": "#/$defs/nonNegativeNumber"
        }
      }
    },
    "outputChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "directory"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "directory": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "diagnosticsConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planes",
        "species",
        "gridPower",
        "summary",
        "plots"
      ],
      "properties": {
        "planes": {
          "$ref": "#/$defs/diagnosticPlanes"
        },
        "species": {
          "$ref": "#/$defs/diagnosticSpeciesConfig"
        },
        "gridPower": {
          "$ref": "#/$defs/diagnosticGridPowerConfig"
        },
        "summary": {
          "$ref": "#/$defs/diagnosticSummaryConfig"
        },
        "plots": {
          "$ref": "#/$defs/diagnosticPlotConfig"
        }
      }
    },
    "diagnosticPlanes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sampleZPositionsMeters",
        "summaryZPositionMeters",
        "emitterExportZPositionMeters"
      ],
      "properties": {
        "sampleZPositionsMeters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          }
        },
        "summaryZPositionMeters": {
          "type": "number"
        },
        "emitterExportZPositionMeters": {
          "type": "number"
        }
      }
    },
    "diagnosticSpeciesConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "writePerSpeciesDiagnostics",
        "writePerSpeciesGridPower",
        "writePerSpeciesPlots",
        "writeNegativeIonSummary"
      ],
      "properties": {
        "writePerSpeciesDiagnostics": {
          "type": "boolean"
        },
        "writePerSpeciesGridPower": {
          "type": "boolean"
        },
        "writePerSpeciesPlots": {
          "type": "boolean"
        },
        "writeNegativeIonSummary": {
          "type": "boolean"
        }
      }
    },
    "diagnosticGridPowerConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ranges"
      ],
      "properties": {
        "writePowerDensityMap": {
          "type": "boolean",
          "description": "Write a per-triangle net power density map (W/cm2) over the boundary triangulation, as <tag>_power_density.vtk plus a text summary. Optional; defaults to false because it costs an extra pass over every impact and is only meaningful when the impact statistics support it."
        },
        "ranges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/diagnosticGridRange"
          }
        }
      }
    },
    "diagnosticGridRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "includeInTotal"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "includeInTotal": {
          "type": "boolean"
        }
      }
    },
    "diagnosticSummaryConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apertureRadiusMeters",
        "transmissionPlaneZPositionMeters"
      ],
      "properties": {
        "apertureRadiusMeters": {
          "$ref": "#/$defs/positiveNumber"
        },
        "transmissionPlaneZPositionMeters": {
          "type": "number",
          "description": "Z position where the extracted current after the PG is evaluated and the EG iteration diagnostic is sampled."
        }
      }
    },
    "diagnosticPlotConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meniscus"
      ],
      "properties": {
        "meniscus": {
          "$ref": "#/$defs/diagnosticMeniscusPlotConfig"
        }
      }
    },
    "diagnosticMeniscusPlotConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "zMinMeters",
        "zMaxMeters",
        "transverseMinMeters",
        "transverseMaxMeters"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "zMinMeters": {
          "type": "number"
        },
        "zMaxMeters": {
          "type": "number"
        },
        "transverseMinMeters": {
          "type": "number"
        },
        "transverseMaxMeters": {
          "type": "number"
        }
      }
    }
  }
}
