prefix=${pcfiledir}
exec_prefix=${prefix}
# CPI patch on 20260604: keep pkg-config resolved against the vendored patched tree.
libdir=${exec_prefix}/src/.libs
includedir=${prefix}/src

Name: libibsimu
Description: Ion Beam Simulation Package
Version: 1.0.6dev
Requires: cairo gsl gtk+-3.0  
Libs: -L${libdir} -libsimu-1.0.6dev -lfreetype  -lfontconfig -lfreetype  -lz -lpng16     
Libs.private: -lm
Cflags: -I${includedir}  
