install-libibsimu_1_0_6dev_la_includeHEADERS: $(libibsimu_1_0_6dev_la_include_HEADERS)
	@$(NORMAL_INSTALL)
	@list='$(libibsimu_1_0_6dev_la_include_HEADERS)'; test -n "$(libibsimu_1_0_6dev_la_includedir)" || list=; \
	if test -n "$$list"; then \
	  echo " $(MKDIR_P) '$(DESTDIR)$(libibsimu_1_0_6dev_la_includedir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(libibsimu_1_0_6dev_la_includedir)" || exit 1; \
	fi; \
	for p in $$list; do \
	  if test -f "$$p"; then d=; else d="$(srcdir)/"; fi; \
	  echo "$$d$$p"; \
	done | $(am__base_list) | \
	while read files; do \
	  echo " $(INSTALL_HEADER) $$files '$(DESTDIR)$(libibsimu_1_0_6dev_la_includedir)'"; \
	  $(INSTALL_HEADER) $$files "$(DESTDIR)$(libibsimu_1_0_6dev_la_includedir)" || exit $$?; \
	done

